{
  "name": "products.org.ai",
  "version": "0.1.0",
  "description": "Product classifications generator",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/generated/types.ts",
    "./schemas": "./src/generated/schemas.ts",
    "./data-full": "./src/generated/data.ts",
    "./metadata": "./src/metadata.ts",
    "./runtime": "./src/runtime.ts",
    "./client": "./src/generated/client.ts"
  },
  "scripts": {
    "generate": "tsx src/scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdxld/loader": "workspace:*",
    "mdxdb": "workspace:*",
    "zod": "catalog:",
    "graphdl": "workspace:*",
    "verbs.org.ai": "workspace:*",
    "onet.org.ai": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
